# Ollama 服务
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_EMBEDDING_DIMENSION=1024
OLLAMA_LLM_MODEL=qwen2.5:3b

# 阿里百炼服务
ALIBABA_DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ALIBABA_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIBABA_EMBEDDING_MODEL=qwen3.7-text-embedding
ALIBABA_EMBEDDING_DIMENSION=1024
ALIBABA_RERANK_MODEL=qwen3-rerank
ALIBABA_LLM_MODEL=qwen3.8-max

# 模型提供方
EMBEDDING_PROVIDER=alibaba
RERANK_PROVIDER=alibaba
LLM_PROVIDER=alibaba

# 检索参数
RETRIEVAL_TOP_K=20
RETRIEVAL_FINAL_TOP_K=20
RERANK_TOP_N=5
VECTOR_THRESHOLD=0.20
RERANK_THRESHOLD=0.2
RERANK_RELATIVE_THRESHOLD=0.6
MIN_RELEVANCE_SCORE=0.45

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag123
POSTGRES_DB=ragdb

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=redis

# 会话记忆
MEMORY_KEEP_RECENT=8
MEMORY_MAX_TOKENS=2500
SESSION_TTL_SECONDS=86400
